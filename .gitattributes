* text=auto

# Go files should use LF (Unix line endings)
*.go text eol=lf

# Certificate and key files should use LF (Unix line endings)
*.pem text eol=lf
*.key text eol=lf
*.crt text eol=lf
*.cert text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Config files
.env text eol=lf
.env.* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.exe binary
*.dll binary